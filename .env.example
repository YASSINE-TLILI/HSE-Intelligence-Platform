# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MySQL connection for API server
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="gestion_hse"

# API server port
API_PORT="4002"
APP_URL="http://localhost:3000"
JWT_SECRET="change-me-please"
ADMIN_APPROVAL_EMAIL="admin@company.local"
COMPANY_EMAIL_DOMAIN="company.com"
VITE_API_URL="http://127.0.0.1:4002"

# SMTP (optional). If not set, emails are logged in API console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@company.local"

# Fallback IDs used for inserts in the incident table
DEFAULT_DECLARANT_ID="1"
DEFAULT_SECTEUR_ID="1"
